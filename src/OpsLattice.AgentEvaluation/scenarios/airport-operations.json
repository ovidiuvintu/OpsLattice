      "expectation": {
        "kind": "results",
        "calls": [
          {
            "tool": "get_flight_count",
            "arguments": {
              "flightType": "Arrival",
              "origin": "LAX",
              "destination": "IAH",
              "date": "2026-10-06"
            },
            "result": "8"
          },
          {
            "tool": "get_flight_count",
            "arguments": {
              "flightType": "Departure",
              "origin": "IAH",
              "destination": "ORD",
              "date": "2026-10-06"
            },
            "result": "9"
          }
        ]
      }
    },
    {
